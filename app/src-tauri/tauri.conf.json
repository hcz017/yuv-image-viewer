{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YUV Image Viewer",
  "version": "0.4.0",
  "identifier": "com.houchengzhi.yuvimageviewer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YUV Image Viewer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["nv12"],
        "name": "NV12 YUV Image",
        "description": "NV12 YUV image",
        "role": "Viewer",
        "mimeType": "application/x-nv12"
      },
      {
        "ext": ["nv21"],
        "name": "NV21 YUV Image",
        "description": "NV21 YUV image",
        "role": "Viewer",
        "mimeType": "application/x-nv21"
      },
      {
        "ext": ["i420"],
        "name": "I420 YUV Image",
        "description": "I420 YUV image",
        "role": "Viewer",
        "mimeType": "application/x-i420"
      },
      {
        "ext": ["yv12"],
        "name": "YV12 YUV Image",
        "description": "YV12 YUV image",
        "role": "Viewer",
        "mimeType": "application/x-yv12"
      },
      {
        "ext": ["p010"],
        "name": "P010 YUV Image",
        "description": "P010 YUV image",
        "role": "Viewer",
        "mimeType": "application/x-p010"
      },
      {
        "ext": ["yuv"],
        "name": "YUV Image",
        "description": "YUV image",
        "role": "Viewer",
        "mimeType": "application/x-yuv"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
